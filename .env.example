# ==============================================================================
# ElajX (علاجك) Environment Variables Configuration
# ==============================================================================
# NOTE: DO NOT commit real secrets or production credentials to source control.
# Copy this file to .env.local for local development.

# --- SUPABASE CONFIGURATION ---
# The public URL of your Supabase project instance (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# The public anonymous API key (safe to expose in client browser)
VITE_SUPABASE_ANON_KEY=

# Server-side service role key (CRITICAL: NEVER expose to client/browser, only used in trusted server endpoints)
SUPABASE_SERVICE_ROLE_KEY=

# --- APPLICATION SETTINGS ---
# Mode: development | staging | production
VITE_APP_ENV=development

# Host URL for deep-links, webhooks, and routing
APP_URL=http://localhost:3000
